# Which provider the UI selects by default: ollama | groq | openai | anthropic
LLM_PROVIDER=ollama

# --- Ollama (free, local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- RAG settings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Set a folder to keep the index between restarts; empty = in-memory
CHROMA_DIR=
